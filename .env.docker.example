# Copy to .env for docker compose (optional — defaults work with shared Postgres)
API_PORT=4000
WEB_PORT=3000
JWT_SECRET=dev-community-shelves-secret
POSTGRES_USER=dev
POSTGRES_PASSWORD=dev
POSTGRES_DB=community_member_shelves
# Browser calls API on the host-mapped port
NEXT_PUBLIC_API_URL=http://localhost:4000
